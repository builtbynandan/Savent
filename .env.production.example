APP_PORT=8080
POSTGRES_DB=savent
POSTGRES_USER=savent
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://savent:replace-with-a-long-random-password@database:5432/savent?schema=public
CLIENT_URL=https://savent.example.com
LOG_LEVEL=info
METRICS_TOKEN=replace-with-a-random-token-at-least-24-characters
RELEASE_SHA=local-production
SESSION_COOKIE_SECURE=true
